# MESH environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed.

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Server-side only. Used by SvelteKit endpoints (e.g. /api/agents/advisor)
# and by Supabase Edge Functions. NEVER expose this to the browser.
ANTHROPIC_API_KEY=

# ─── Supabase (not yet wired — populated in Sprint 1) ─────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Victorian open data (not yet wired — Sprint 1) ──────────────────────────
VIC_DATA_API_KEY=
MELBOURNE_DATA_APP_TOKEN=

# ─── Google Maps Platform (used by the home page 2.5D map) ───────────────────
# 1. Create a GCP project + enable billing (free $200/month credit covers us).
# 2. Enable "Maps JavaScript API" in APIs & Services → Library.
# 3. Create an API key, restrict to your domains (localhost:5173, your Vercel URL).
# 4. Create a Map ID under Google Maps Platform → Map Management. Set
#    Map type = JavaScript, enable Tilt + Rotation. The Map ID is what
#    unlocks the WebGL vector renderer with 3D buildings.
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_GOOGLE_MAPS_MAP_ID=
